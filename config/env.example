# Copy to ~/.config/daily-checkin/env and edit for your machine.
# Keep secrets out of this file; store site credentials through the web UI
# (macOS Keychain) or the file backend, never in env / task files / git.

# Optional Obsidian daily-task directory.
# DAILY_CHECKIN_TASKS_DIR="$HOME/path/to/obsidian/Task/daily"

# Optional runtime locations.
# DAILY_CHECKIN_DB="$HOME/.hermes/checkin/system.db"
# DAILY_CHECKIN_LOG_DIR="$HOME/.hermes/checkin"
# Required when the Hermes wrapper is copied into ~/.hermes/scripts.
# DAILY_CHECKIN_ROOT="/absolute/path/to/daily-checkin-system"
# BATCH_TIMEOUT_S=6600
# BATCH_CLEANUP_RESERVE_S=30

# Account+password credential doc (no-OAuth sites). Default is the iCloud vault
# doc on macOS; on Linux set this explicitly to the provisioned 0600 file.
# DAILY_CHECKIN_ACCOUNTS_FILE="/absolute/path/to/accounts.md"

# Web console login.
# Password-based login for the local Web UI (X-DailyCheckin-Password). When set,
# the UI prompts for a password; the legacy bearer token (web.token) stays
# accepted for backward compatibility. Never commit the real password — provide
# it in the untracked local env / launchd / supervisor environment.
# DAILY_CHECKIN_WEB_PASSWORD="REPLACE_ME"
# CORS allow-list for the separate static frontend that calls the API cross-origin.
# Comma-separated loopback origins only; wildcard is rejected. Defaults to the
# two 127.0.0.1/localhost:8766 variants for the dev frontend.
# DAILY_CHECKIN_WEB_ORIGINS="http://127.0.0.1:8766,http://localhost:8766"

# Credential backend for the web console's saved token/cookie/password.
#   keychain -> macOS Keychain (default on macOS)
#   file     -> 0600 JSON file (default on Linux)
# DAILY_CHECKIN_CREDENTIAL_BACKEND=file
# Optional override for the file backend location (default ~/.config/daily-checkin/credentials.json).
# DAILY_CHECKIN_CREDENTIALS_FILE="/absolute/path/to/credentials.json"
# DAILY_CHECKIN_CREDENTIALS_DIR="/absolute/path/to/cred-dir"
39

# Optional CDP endpoint. CLI --cdp takes precedence. On a host that may already
# run other headless automation, pick an isolated loopback port.
# CDP_PORT=9333
# CDP_HTTP="http://127.0.0.1:9333"

# Optional behavior tuning.
# SITE_TIMEOUT_S=90
# CAPTCHA_WAIT_S=40
# CF_WAIT_S=40
# SSO_TIMEOUT_S=45
# CHECKIN_PROVIDER_ENGINE=provider
